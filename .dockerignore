# A whitelist: only what git tracks goes into the image, local files of a working copy stay out.
# A panel move packs the code of the image for the new machine, so the installer files are kept
# too. A new top-level file or script goes here as well; config/tests/test_dockerignore.py checks.
*

!.dockerignore
!.env.example
!.gitattributes
!.gitignore
!.python-version
!CHANGELOG.md
!CODE_OF_CONDUCT.md
!CONTRIBUTING.md
!Caddyfile
!Dockerfile
!LICENSE
!Makefile
!NOTICE
!README.md
!README_RU.md
!SECURITY.md
!compose.dev.yaml
!compose.yaml
!install.sh
!manage.py
!pyproject.toml
!uv.lock

!amnezia_core
!apps
!assets
!config
!deploy
!examples
!locale
!static
!templates

!scripts/check_messages.py
!scripts/publish_wiki.py
!scripts/tailwind.py
!scripts/test_publish_wiki.py
!scripts/test_tailwind.py
!scripts/ui_check.py
!scripts/ui_seed.py

# Built or local files inside the kept folders: the build makes them anew.
**/__pycache__
**/*.py[cod]
**/*.mo
**/*.sqlite3
static/css/app.css
