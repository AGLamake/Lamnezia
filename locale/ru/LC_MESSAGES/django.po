#, python-format
msgid "3proxy.log of the app: %(size)s"
msgstr "3proxy.log приложения: %(size)s"

msgid "A link"
msgstr "Ссылка"

msgid "A new subscription link is ready."
msgstr "Новая ссылка-подписка готова."

msgid "A new user waits for a plan"
msgstr "Новый пользователь ждёт тарифа"

msgid "A new user waits for approval"
msgstr "Новый пользователь ждёт подтверждения"

msgid "A plan sets the servers, protocols and limits of its users."
msgstr "Тариф задаёт серверы, протоколы и лимиты своих пользователей."

msgid "A revoked key stops working at once and cannot be turned back on."
msgstr "Отозванный ключ сразу перестаёт работать, вернуть его нельзя."

msgid "A server is either standalone or a member of one group. Let it leave first."
msgstr "Сервер либо одиночный, либо участник одной группы. Сначала выведите его из группы."

msgid "A small STUN responder on a UDP port. Users' browsers ask it and warn when the server cannot be reached from their network. It keeps no logs."
msgstr "Маленький STUN-ответчик на UDP-порту. Браузеры пользователей обращаются к нему и предупреждают, если сервер недоступен из их сети. Журналов он не ведёт."

msgid "A standalone AmneziaWG 3.1 server. Its keys, settings and clients become the group's."
msgstr "Одиночный сервер AmneziaWG 3.1. Его ключи, настройки и клиенты становятся ключами, настройками и клиентами группы."

msgid "A user cannot be their own moderator."
msgstr "Пользователь не может быть своим же модератором."

msgid "Access"
msgstr "Доступ"

msgid "Access denied"
msgstr "Доступ запрещён"

msgid "Access ends in 7 days"
msgstr "Доступ кончается за 7 дней"

msgid "Access until"
msgstr "Доступ до"

msgid "Account"
msgstr "Аккаунт"

#, python-format
