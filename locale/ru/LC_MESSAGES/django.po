msgstr "Сохранить результат в панели"

msgid "Saved."
msgstr "Сохранено."

msgid "Saving…"
msgstr "Сохраняем…"

msgid "Scan all codes one after another in the Amnezia app."
msgstr "Отсканируйте все коды по очереди в приложении Amnezia."

msgid "Scan the QR code with the app or enter the key by hand."
msgstr "Отсканируйте QR-код в приложении или введите ключ вручную."

msgid "Screenshot"
msgstr "Скриншот"

msgid "Secondary"
msgstr "Вторичная"

