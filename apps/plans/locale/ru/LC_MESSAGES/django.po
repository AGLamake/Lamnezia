msgid "keys at most"
msgstr "ключей не больше"

msgid "name"
msgstr "название"

msgid "period, days"
msgstr "период, дней"

msgid "plan"
msgstr "тариф"

msgid "plan assigned at"
msgstr "тариф назначен"

msgid "plans"
msgstr "тарифы"

msgid "price"
msgstr "цена"

msgid "protocols"
msgstr "протоколы"

msgid "servers"
msgstr "серверы"

msgid "speed, Mbit/s"
msgstr "скорость, Мбит/с"

msgid "traffic in total"
msgstr "трафик всего"

msgid "traffic per period"
