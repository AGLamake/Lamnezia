#, python-format
msgid "%(address)s is an address in a private network. Allow such addresses in the panel settings if the receiver is in your own network."
msgstr "%(address)s — адрес в частной сети. Разрешите такие адреса в настройках панели, если получатель в вашей собственной сети."

msgid "A number, e.g. -1001234567890, or @channel_name."
msgstr "Число, например -1001234567890, или @имя_канала."

msgid "A test message is on its way. The result is in the log."
msgstr "Тестовое сообщение отправляется. Результат — в журнале."

msgid "Access ends soon"
msgstr "Доступ скоро закончится"

msgid "Addresses"
msgstr "Адреса"

