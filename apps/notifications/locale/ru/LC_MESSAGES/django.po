msgstr "Статус обращения: {status}."

#, python-brace-format
msgid "The server {server} ({host}) answers again. Answer before the outage: {last_seen}."
msgstr "Сервер {server} ({host}) снова отвечает. Последний ответ до сбоя: {last_seen}."

#, python-brace-format
msgid "The server {server} ({host}) does not answer. Last answer: {last_seen}."
msgstr "Сервер {server} ({host}) не отвечает. Последний ответ: {last_seen}."

#, python-brace-format
msgid "The server {server} has missed key changes of the group {group} since {since}: {reason}. The relay skips it until the panel copies the group files onto it."
msgstr "Сервер {server} пропускает изменения ключей группы {group} с {since}: {reason}. Ретранслятор обходит его, пока панель не скопирует на него файлы группы."

#, python-brace-format
msgid "The server {server} has the files of the group {group} again after lagging behind since {since}. The relay sends clients to it again."
msgstr "Сервер {server} снова получил файлы группы {group} после отставания с {since}. Ретранслятор снова отправляет на него клиентов."

#, python-brace-format
msgid "The settings of {server} have changed. Open your keys in the personal account and import them into the Amnezia app again: the old ones no longer connect."
msgstr "Настройки сервера {server} изменились. Откройте свои ключи в личном кабинете и заново импортируйте их в приложение Amnezia: старые больше не подключаются."

