msgstr "Инцидент на {server} закрыт."

#, python-brace-format
msgid "The keys of {user} are turned off: {reason}."
msgstr "Ключи пользователя {user} отключены: {reason}."

#, python-brace-format
msgid "The panel cannot read the state of the relay {relay} ({host}). Last reading: {last_seen}. The relay may still forward the clients on its own."
msgstr "Панель не может прочитать состояние ретранслятора {relay} ({host}). Последнее чтение: {last_seen}. Сам ретранслятор при этом может продолжать пересылать клиентов."

#, python-brace-format
msgid "The panel reads the state of the relay {relay} ({host}) again. Reading before the outage: {last_seen}."
msgstr "Панель снова читает состояние ретранслятора {relay} ({host}). Последнее чтение до сбоя: {last_seen}."

#, python-brace-format
msgid "The problem with {server} you reported is fixed. Thank you for telling us."
msgstr "Проблема с {server}, о которой вы сообщили, устранена. Спасибо, что рассказали."

#, python-brace-format
msgid "The relay {relay} cannot reach the server {from}, so the clients of the group {group} go through {to} now. Their connection drops for a few seconds."
msgstr "Ретранслятор {relay} не достучался до сервера {from}, поэтому клиенты группы {group} теперь идут через {to}. Их соединение прерывается на несколько секунд."

#, python-brace-format
msgid "The relay {relay} cannot reach the server {server} of the group {group}. The relay sends no clients to it until it answers again."
msgstr "Ретранслятор {relay} не достучался до сервера {server} группы {group}. Ретранслятор не отправляет на него клиентов, пока он снова не ответит."

#, python-brace-format
msgid "The relay {relay} reaches a server of the group {group} again. The clients of the group have a connection."
msgstr "Ретранслятор {relay} снова получает ответ от сервера группы {group}. У клиентов группы есть связь."

#, python-brace-format
msgid "The relay {relay} reaches no server of the group {group}. The clients of the group have no connection."
msgstr "Ретранслятор {relay} не достучался ни до одного сервера группы {group}. У клиентов группы нет соединения."

#, python-brace-format
msgid "The relay {relay} reaches the server {server} of the group {group} again and may send clients to it."
msgstr "Ретранслятор {relay} снова получает ответ от сервера {server} группы {group} и может отправлять на него клиентов."

#, python-brace-format
