#, python-brace-format
msgid "Thank you! The staff published your suggestion in the guides: {title}"
msgstr "Спасибо! Персонал опубликовал ваше предложение в инструкциях: {title}"

msgid "The Discord user ID is a number."
msgstr "ID пользователя Discord — это число."

#, python-brace-format
msgid "The VPN access of {user} ends on {until}."
msgstr "Доступ к VPN пользователя {user} заканчивается {until}."

#, python-brace-format
msgid "The VPN protocol is removed from {server}, and your keys on it no longer connect. Open the personal account to see the keys you have."
msgstr "VPN-протокол удалён с сервера {server}, и ваши ключи на нём больше не подключаются. Откройте личный кабинет, чтобы увидеть свои ключи."

msgid "The body is signed with it in the X-Lamnezia-Signature header."
msgstr "Им подписывается тело запроса в заголовке X-Lamnezia-Signature."

msgid "The channel is deleted."
msgstr "Канал удалён."

#, python-brace-format
msgid "The incident on {server} is closed."
msgstr "Инцидент на {server} закрыт."

#, python-brace-format
msgid "The keys of {user} are turned off: {reason}."
msgstr "Ключи пользователя {user} отключены: {reason}."

#, python-brace-format
msgid "The problem with {server} you reported is fixed. Thank you for telling us."
msgstr "Проблема с {server}, о которой вы сообщили, устранена. Спасибо, что рассказали."

#, python-brace-format
msgid "The request is now {status}."
msgstr "Статус обращения: {status}."

#, python-brace-format
msgid "The server {server} ({host}) does not answer. Last answer: {last_seen}."
msgstr "Сервер {server} ({host}) не отвечает. Последний ответ: {last_seen}."

#, python-brace-format
msgid "The settings of {server} have changed. Open your keys in the personal account and import them into the Amnezia app again: the old ones no longer connect."
msgstr "Настройки сервера {server} изменились. Откройте свои ключи в личном кабинете и заново импортируйте их в приложение Amnezia: старые больше не подключаются."

#, python-brace-format
msgid ""
"The staff declined your suggestion: {title}\n"
"Reason: {reason}"
msgstr ""
"Персонал отклонил ваше предложение: {title}\n"
"Причина: {reason}"

#, python-brace-format
msgid "There is a new answer to your request: {topic}."
msgstr "На ваше обращение пришёл новый ответ: {topic}."

msgid "There is a new message in your support chat."
msgstr "В чате поддержки новое сообщение."

msgid "URL"
msgstr "URL"

#, python-brace-format
