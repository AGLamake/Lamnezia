msgid "Thank you! The staff published your suggestion in the guides: {title}"
msgstr "Спасибо! Персонал опубликовал ваше предложение в инструкциях: {title}"

msgid "The Discord user ID is a number."
msgstr "ID пользователя Discord — это число."

#, python-brace-format
msgid "The VPN access of {user} ends on {until}."
msgstr "Доступ к VPN пользователя {user} заканчивается {until}."

#, python-brace-format
msgid "The VPN protocol is removed from {server}, and your keys on it no longer connect. Open the personal account to see the keys you have."
msgstr "VPN-протокол удалён с сервера {server}, и ваши ключи на нём больше не подключаются. Откройте личный кабинет, чтобы увидеть свои ключи."

#, python-brace-format
msgid "The XRay settings of {server} have changed. Open your keys in the personal account and import them into the Amnezia app again: the ones added before no longer connect. A subscription link picks the change up by itself."
msgstr "Настройки XRay на сервере {server} изменились. Откройте свои ключи в личном кабинете и заново импортируйте их в приложение Amnezia: добавленные раньше больше не подключаются. Ключи по ссылке-подписке обновятся сами."

#, python-brace-format
msgid "The amneziawg kernel module on {server} ({host}) is older than 3.1 and dropped the AmneziaWG 3.1 settings: clients with them do not connect. Update or remove the amneziawg module on the host and restart amnezia-awg2."
msgstr "Модуль ядра amneziawg на сервере {server} ({host}) старше 3.1 и отбросил настройки AmneziaWG 3.1: клиенты с ними не подключаются. Обновите или удалите модуль amneziawg на хосте и перезапустите amnezia-awg2."

msgid "The body is signed with it in the X-Lamnezia-Signature header."
msgstr "Им подписывается тело запроса в заголовке X-Lamnezia-Signature."

msgid "The channel is deleted."
msgstr "Канал удалён."

