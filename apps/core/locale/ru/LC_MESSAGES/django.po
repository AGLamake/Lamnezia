# Russian translation of Lamnezia (apps.core).
msgid ""
msgstr ""
"Report-Msgid-Bugs-To: \n"
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

#, python-format
msgid "%(size)s/s"
msgstr "%(size)s/с"

msgid "A bot username: 5 to 32 Latin letters, digits and _."
msgstr "Имя бота: от 5 до 32 латинских букв, цифр и _."

msgid "A load alert comes after this many monitor readings in a row above the threshold, and the all-clear after as many below it, so a short spike wakes nobody."
msgstr "Предупреждение о нагрузке приходит после стольких замеров монитора подряд выше порога, а сообщение о норме — после стольких же ниже него, чтобы короткий всплеск никого не будил."

msgid "A summary in the morning: servers down, traffic, access ending, failed operations, backups and new requests. The channels subscribed to the report get the whole panel, each moderator gets their own zone."
msgstr "Сводка по утрам: упавшие серверы, трафик, заканчивающийся доступ, ошибки операций, бэкапы и новые обращения. Каналы, подписанные на отчёт, получают всю панель, каждый модератор — свою зону."

msgid "A user hears once a period that this share of their traffic limit is used. 0 turns the warning off."
msgstr "Пользователь один раз за период узнаёт, что израсходовал эту долю лимита трафика. 0 — не предупреждать."

msgid "Administrators hear when a server has this many active keys or more. Empty turns it off."
msgstr "Администраторы узнают, когда на сервере столько активных ключей или больше. Пусто — не следить."

msgid "Administrators hear when the CPU of a server stays this busy. 0 turns it off."
msgstr "Администраторы получают уведомление, когда процессор сервера долго загружен на столько. 0 — выключить."

msgid "Any time"
msgstr "В любое время"

msgid "Bot page of the Discord application. The bot sends keys and notifications."
msgstr "Страница Bot приложения Discord. Бот выдаёт ключи и присылает уведомления."

msgid "By invitation only"
msgstr "Только по приглашению"

msgid "CPU load alert, %"
msgstr "предупреждение о процессоре, %"

msgid "Discord application ID"
msgstr "ID приложения Discord"

msgid "Discord bot token"
msgstr "Токен Discord-бота"

msgid "Discord client secret"
msgstr "Секрет клиента Discord"

msgid "Enter port numbers from 1 to 65535."
msgstr "Введите номера портов от 1 до 65535."

msgid "Every day"
msgstr "Каждый день"

msgid "Every week"
msgstr "Каждую неделю"

msgid "From @BotFather."
msgstr "Выдаёт @BotFather."

msgid "From the Discord Developer Portal; users link their Discord through it."
msgstr "Из Discord Developer Portal; через это приложение пользователи привязывают Discord."

msgid "GitHub token"
msgstr "Токен GitHub"

msgid "Give the subscription to clients that do not send x-hwid. Off: only clients that send it, so the plan's device limit cannot be bypassed."
msgstr "Выдавать подписку клиентам, которые не шлют x-hwid. Выключено: только тем, кто шлёт, чтобы лимит устройств тарифа нельзя было обойти."

msgid "Given to new users in open registration with automatic approval."
msgstr "Выдаётся новым пользователям при открытой регистрации с автоматическим допуском."

msgid "Hello! Can I pay for a year?"
msgstr "Здравствуйте! Можно оплатить сразу год?"

msgid "Helsinki is slow"
msgstr "Хельсинки тормозит"

msgid "Name the ports users may test."
msgstr "Укажите порты, которые пользователи могут замерять."

msgid "None"
msgstr "Нет"

msgid "OAuth2 page of the Discord application."
msgstr "Страница OAuth2 приложения Discord."

msgid "Off"
msgstr "Выключен"

msgid "Only a link to the portal"
msgstr "Только ссылку на портал"

msgid "Only once"
msgstr "Только один раз"

msgid "Open, an administrator approves"
msgstr "Открытая, с одобрением администратора"

msgid "Open, the default plan right away"
msgstr "Открытая, сразу тариф по умолчанию"

msgid "Remove the saved value"
msgstr "Удалить сохранённое значение"

msgid "SMTP password"
msgstr "Пароль SMTP"

msgid "SMTP port"
msgstr "порт SMTP"

msgid "SMTP server"
msgstr "SMTP-сервер"

msgid "SMTP user"
msgstr "пользователь SMTP"

msgid "Saved. Leave empty to keep it."
msgstr "Сохранён. Оставьте пустым, чтобы не менять."

msgid "Separated by commas. A port taken on the server is not offered."
msgstr "Через запятую. Порт, занятый на сервере, не предлагается."

msgid "Settings saved."
msgstr "Настройки сохранены."

msgid "Signed-in users send links and texts for the guides; the staff review them."
msgstr "Вошедшие пользователи присылают ссылки и тексты для инструкций; персонал их проверяет."

msgid "Speed dropped to 1 Mbit/s since the morning."
msgstr "С утра скорость упала до 1 Мбит/с."

msgid "Telegram and Discord keep chats on their servers without end-to-end encryption."
msgstr "Telegram и Discord хранят чаты на своих серверах без сквозного шифрования."

msgid "Telegram bot token"
msgstr "Токен Telegram-бота"

msgid "Telegram bot username"
msgstr "Имя Telegram-бота"

msgid "The app says the config is wrong."
msgstr "Приложение пишет, что конфигурация неверная."

msgid "The key does not import"
msgstr "Ключ не импортируется"

msgid "The key itself"
msgstr "Сам ключ"

msgid "The same for the disk space used. 0 turns it off."
msgstr "То же для занятого места на диске. 0 — выключить."

msgid "The same for the memory used. 0 turns it off."
msgstr "То же для занятой памяти. 0 — выключить."

msgid "The same for the traffic through a server in the last 24 hours. Empty turns it off."
msgstr "То же для трафика через сервер за последние 24 часа. Пусто — не следить."

msgid "Up to eight ports."
msgstr "Не больше восьми портов."

msgid "Update the app, please."
msgstr "Обновите, пожалуйста, приложение."

msgid "Users measure in the browser the ports of a server they have a key on, for ten minutes, three times an hour at most."
msgstr "Пользователи замеряют в браузере порты сервера, на котором у них есть ключ: на десять минут, не чаще трёх раз в час."

msgid "Users with a linked Discord can sign in with it."
msgstr "Пользователи с привязанным Discord смогут входить через него."

msgid "Users with a linked Telegram can sign in with it."
msgstr "Пользователи с привязанным Telegram могут входить через него."

msgid "Users with a linked Telegram can sign in with it. Set the domain in @BotFather."
msgstr "Пользователи с привязанным Telegram смогут входить через него. Укажите домен панели в @BotFather."

msgid "Webhooks may go to addresses such as 127.0.0.1, 10.0.0.0/8 or 192.168.0.0/16. Turn on only for a receiver in your own network."
msgstr "Вебхуки могут уходить на адреса вроде 127.0.0.1, 10.0.0.0/8 или 192.168.0.0/16. Включайте, только если получатель в вашей собственной сети."

msgid "While the load stays high, the alert is repeated no more often than this; a load back above the threshold sooner is not told again."
msgstr "Пока нагрузка высокая, предупреждение повторяется не чаще этого; если нагрузка снова превысила порог раньше, о ней не сообщается повторно."

msgid "Without @. Users link their Telegram through this bot."
msgstr "Без @. Через этого бота пользователи привязывают свой Telegram."

msgid "Without scopes. Raises the GitHub limit for Amnezia app download links."
msgstr "Без прав доступа. Повышает лимит GitHub для ссылок на загрузку приложения Amnezia."

msgid "Yes, write the plan and we will send the payment details."
msgstr "Да, напишите тариф, и мы пришлём реквизиты для оплаты."

msgid "active keys per server"
msgstr "активных ключей на сервер"

msgid "cleanup"
msgstr "чистка"

msgid "cleanups"
msgstr "чистки"

msgid "confirm email on registration"
msgstr "подтверждать email при регистрации"

msgid "default plan"
msgstr "тариф по умолчанию"

msgid "disk alert, %"
msgstr "предупреждение о диске, %"

msgid "encryption"
msgstr "шифрование"

msgid "keys in the bots"
msgstr "ключи в ботах"

msgid "memory alert, %"
msgstr "предупреждение о памяти, %"

msgid "notifications to private networks"
msgstr "уведомления в частные сети"

msgid "panel name"
msgstr "название панели"

msgid "panel settings"
msgstr "настройки панели"

msgid "ports for the users' speed test"
msgstr "порты для замера пользователями"

msgid "ran at"
msgstr "время запуска"

msgid "readings in a row"
msgstr "замеров подряд"

msgid "registration"
msgstr "регистрация"

msgid "repeat load alert, hours"
msgstr "повтор предупреждения о нагрузке, ч"

msgid "report to the staff"
msgstr "отчёт персоналу"

msgid "rows removed"
msgstr "удалено строк"

msgid "sender"
msgstr "отправитель"

msgid "showing a key again"
msgstr "повторный показ ключа"

msgid "sign in with Discord"
msgstr "вход через Discord"

msgid "sign in with Telegram"
msgstr "вход через Telegram"

msgid "subscription without a device ID"
msgstr "подписка без ID устройства"

msgid "task"
msgstr "задача"

msgid "traffic per server in a day, GB"
msgstr "трафик сервера за сутки, ГБ"

msgid "traffic warning, %"
msgstr "предупреждение о трафике, %"

msgid "users suggest articles"
msgstr "пользователи предлагают статьи"

msgid "users test port speed"
msgstr "пользователи замеряют скорость портов"
